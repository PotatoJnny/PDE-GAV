+use super::*;
+use codex_protocol::protocol::FileSystemSandboxEntry;
+use pretty_assertions::assert_eq;
+use tempfile::TempDir;
+use test_case::test_case;
+
+fn entry(path: &str, access: FileSystemAccessMode) -> FileSystemSandboxEntry {
+    FileSystemSandboxEntry {
+        path: AbsolutePathBuf::from_absolute_path(path)
+            .expect("absolute fixture path")
+            .into(),
+        access,
+        missing_path_behavior: None,
+    }
+}
+
+#[test_case("/dev/nvidia0"; "GPU zero")]
+#[test_case("/dev/nvidia15"; "GPU minor fifteen")]
+#[test_case("/dev/nvidiactl"; "driver control")]
+#[test_case("/dev/nvidia-uvm"; "unified memory")]
+#[test_case("/dev/nvidia-uvm-tools"; "unified memory tools")]
+fn requires_exact_write_authorization(path: &str) {
+    let root = Path::new(path);
+    let cwd = Path::new("/");
+    let cases = [
+        (vec![entry(path, FileSystemAccessMode::Write)], true),
+        (vec![entry(path, FileSystemAccessMode::Read)], false),
+        (vec![entry("/dev", FileSystemAccessMode::Write)], false),
+        (vec![entry("/", FileSystemAccessMode::Write)], false),
+        (
+            vec![
+                entry(path, FileSystemAccessMode::Write),
+                entry(path, FileSystemAccessMode::Deny),
+            ],
+            false,
+        ),
+        (
+            vec![
+                entry("/dev", FileSystemAccessMode::Deny),
+                entry(path, FileSystemAccessMode::Write),
+            ],
+            true,
+        ),
+    ];
+    for (entries, expected) in cases {
+        let policy = FileSystemSandboxPolicy::restricted(entries);
+        assert_eq!(
+            has_explicit_nvidia_device_write(&policy, root, cwd),
+            expected,
+            "policy: {policy:?}"
+        );
+    }
+}
+
+#[test_case("/dev"; "device directory")]
+#[test_case("/dev/null"; "unrelated character device")]
+#[test_case("/dev/nvidia"; "missing GPU minor")]
+#[test_case("/dev/nvidia*"; "wildcard")]
+#[test_case("/dev/nvidia-1"; "negative minor")]
+#[test_case("/dev/nvidia-caps"; "capability directory")]
+#[test_case("/dev/nvidia-caps/nvidia-cap1"; "unreviewed capability node")]
+#[test_case("/dev/nvidia0/.git"; "child of leaf")]
+#[test_case("/tmp/nvidia0"; "wrong parent")]
+fn rejects_non_allowlisted_device_grants(path: &str) {
+    let policy =
+        FileSystemSandboxPolicy::restricted(vec![entry(path, FileSystemAccessMode::Write)]);
+    assert!(!has_explicit_nvidia_device_write(
+        &policy,
+        Path::new(path),
+        Path::new("/")
+    ));
+}
+
+#[test]
+fn ordinary_workspace_keeps_protected_metadata_and_no_device_binds() {
+    let workspace = TempDir::new().expect("workspace");
+    let policy = FileSystemSandboxPolicy::workspace_write(
+        &[],
+        /*exclude_tmpdir_env_var*/ true,
+        /*exclude_slash_tmp*/ true,
+    );
+    let args = create_filesystem_args(&policy, workspace.path(), /*glob_scan_max_depth*/ None)
+        .expect("ordinary workspace args");
+    assert!(!args.args.iter().any(|arg| arg == "--dev-bind"));
+    for name in [".git", ".codex", ".agents"] {
+        let path = workspace.path().join(name);
+        assert!(
+            args.synthetic_mount_targets
+                .iter()
+                .any(|target| target.path() == path)
+        );
+    }
+}
+
+#[test]
+#[ignore = "requires a compute host with actual NVIDIA character devices; does not run CUDA"]
+fn actual_device_binds_are_leaf_scoped_and_preserve_workspace_protections() {
+    let workspace = TempDir::new().expect("workspace");
+    let device = fs::read_dir("/dev")
+        .expect("read /dev")
+        .map(|entry| entry.expect("device entry").path())
+        .find(|path| {
+            let policy = FileSystemSandboxPolicy::restricted(vec![entry(
+                path.to_str().expect("device path"),
+                FileSystemAccessMode::Write,
+            )]);
+            has_explicit_nvidia_device_write(&policy, path, workspace.path())
+                && fs::symlink_metadata(path)
+                    .expect("device metadata")
+                    .file_type()
+                    .is_char_device()
+        })
+        .expect("test explicitly requires an NVIDIA device");
+    let device_string = path_to_string(&device);
+    let mut policy = FileSystemSandboxPolicy::workspace_write(
+        &[],
+        /*exclude_tmpdir_env_var*/ true,
+        /*exclude_slash_tmp*/ true,
+    );
+    policy
+        .entries
+        .push(entry(&device_string, FileSystemAccessMode::Write));
+    let args = create_filesystem_args(&policy, workspace.path(), /*glob_scan_max_depth*/ None)
+        .expect("device workspace args");
+    let private_dev = args
+        .args
+        .windows(2)
+        .position(|args| args == ["--dev", "/dev"])
+        .expect("minimal private /dev");
+    let device_bind = args
+        .args
+        .windows(3)
+        .position(|args| args == ["--dev-bind", device_string.as_str(), device_string.as_str()])
+        .expect("exact device bind");
+    assert!(private_dev < device_bind);
+    assert!(
+        !args
+            .synthetic_mount_targets
+            .iter()
+            .any(|target| target.path().starts_with(&device))
+    );
+    assert!(
+        !args
+            .protected_create_targets
+            .iter()
+            .any(|target| target.path().starts_with(&device))
+    );
+    for name in [".git", ".codex", ".agents"] {
+        let path = workspace.path().join(name);
+        assert!(
+            args.synthetic_mount_targets
+                .iter()
+                .any(|target| target.path() == path)
+        );
+    }
+    policy
+        .entries
+        .push(entry(&device_string, FileSystemAccessMode::Deny));
+    let denied =
+        create_filesystem_args(&policy, workspace.path(), /*glob_scan_max_depth*/ None)
+            .expect("denied device workspace args");
+    assert!(!denied.args.iter().any(|arg| arg == "--dev-bind"));
+}
