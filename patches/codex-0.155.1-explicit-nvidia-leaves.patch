+/// Opt in only through a literal write rule for an exact NVIDIA device leaf.
+/// Read rules, ancestor grants, aliases, and other /dev nodes never enable a
+/// device bind. The effective-policy check preserves same-path deny precedence.
+fn has_explicit_nvidia_device_write(
+    policy: &FileSystemSandboxPolicy,
+    root: &Path,
+    cwd: &Path,
+) -> bool {
+    if root.parent() != Some(Path::new("/dev")) {
+        return false;
+    }
+    let Some(name) = root.file_name().and_then(|name| name.to_str()) else {
+        return false;
+    };
+    let allowed_name = matches!(name, "nvidiactl" | "nvidia-uvm" | "nvidia-uvm-tools")
+        || name.strip_prefix("nvidia").is_some_and(|index| {
+            !index.is_empty() && index.bytes().all(|byte| byte.is_ascii_digit())
+        });
+    allowed_name
+        && policy.entries.iter().any(|entry| {
+            entry.access == FileSystemAccessMode::Write
+                && matches!(&entry.path, FileSystemPath::Path { path }
+                    if path.to_abs_path().is_ok_and(|path| path.as_path() == root))
+        })
+        && policy.can_write_local_path_with_cwd(root, cwd)
+}
